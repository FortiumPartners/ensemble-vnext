{
  "devDependencies": {
    "bats": "^1.13.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "mock-fs": "^5.5.0"
  },
  "name": "ensemble-vnext",
  "version": "4.7.2",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "jest",
    "test:evals": "jest --testPathIgnorePatterns '/node_modules/' --testPathPattern 'test/evals'",
    "check:versions": "./packages/core/scripts/check-version-sync.sh",
    "smoke": "./test/smoke/run-smoke.sh",
    "smoke:full": "./test/smoke/run-smoke.sh --with-llm",
    "test:tooling": "jest --testPathIgnorePatterns '/node_modules/' --testPathPattern 'test/(evals|discipline-corpus|integration/hooks)'"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/worktrees/",
      "<rootDir>/test/evals/",
      "<rootDir>/test/discipline-corpus/",
      "<rootDir>/test/integration/hooks/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/",
      "<rootDir>/test/evals/",
      "<rootDir>/test/discipline-corpus/",
      "<rootDir>/test/integration/hooks/"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islayjames/ensemble-vnext.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/islayjames/ensemble-vnext/issues"
  },
  "homepage": "https://github.com/islayjames/ensemble-vnext#readme",
  "description": ""
}
