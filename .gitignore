# Ensemble vNext .gitignore

# Local settings (not committed)
.claude/settings.local.json
.claude/*.local.*

# Note: .trd-state/ IS tracked for parallel execution coordination.
# Do NOT add .trd-state/ to gitignore. implement.json is per-feature, carries the
# durable progress, and never collides.
#
# TWO EXCEPTIONS -- both are per-session working state, not project artifacts, and
# tracking them makes every feature branch rewrite one shared file. That is a merge
# conflict by construction, and it is what breaks two worktrees off one repo.
#
#   current.json      pointer at whichever TRD this working tree is on. Coordinates
#                     nothing. If absent, derive from the branch name; fall back to an
#                     explicit path argument.
#   wiggum-state.json within-session loop state (iteration_count, stop_hook_active,
#                     last_prompt, started_at). Two worktrees running --wiggum would
#                     otherwise share one counter.
.trd-state/current.json
.trd-state/wiggum-state.json

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# Node.js (for hook development)
node_modules/
npm-debug.log
yarn-error.log

# Python (for legacy router hook)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
*.egg-info/

# Test artifacts
coverage/
.nyc_output/
*.log
test/evals/results/

# Session logs directory
.claude-sessions/

# Environment files with secrets
.env
test/.env
.env.local
.env.*.local

# implement-trd lock (session-scoped)
.trd-state/*/implement.lock

# Verifier findings are per-run scratch (create-prd / create-trd verify wave)
.trd-state/*/findings/

# Agent worktrees (transient, per-agent isolated checkouts)
.claude/worktrees/
